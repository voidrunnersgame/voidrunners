for name, content in files.items():
    (base / name).write_text(content, encoding="utf-8")

zip_path = Path("/mnt/data/void_runners_website.zip")
with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zf:
    for name in files:
        zf.write(base / name, arcname=name)

print("Created the Void Runners website ZIP and the three individual files.")
print(f"ZIP: {zip_path}")
print(f"Files: {', '.join(str(base / name) for name in files)}")
